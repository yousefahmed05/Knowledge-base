<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">try{
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed": "#e1e2e4",
                        "primary-fixed-dim": "#ffb3ae",
                        "on-background": "#1b1c1c",
                        "outline": "#8d706e",
                        "on-tertiary-fixed-variant": "#444749",
                        "secondary-fixed-dim": "#c5c6cc",
                        "secondary": "#5c5e63",
                        "primary-container": "#a72429",
                        "surface": "#fcf9f8",
                        "tertiary-container": "#55585a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "secondary-container": "#e1e2e8",
                        "on-surface": "#1b1c1c",
                        "secondary-fixed": "#e1e2e8",
                        "on-primary-fixed-variant": "#8f0f1a",
                        "primary": "#850515",
                        "surface-dim": "#dcd9d9",
                        "background": "#fcf9f8",
                        "surface-variant": "#e5e2e1",
                        "on-primary-container": "#ffbeba",
                        "error": "#ba1a1a",
                        "inverse-on-surface": "#f3f0ef",
                        "outline-variant": "#e1bfbc",
                        "surface-tint": "#b12b2f",
                        "surface-container-highest": "#e5e2e1",
                        "surface-container-high": "#eae7e7",
                        "primary-fixed": "#ffdad7",
                        "inverse-surface": "#303030",
                        "on-tertiary-container": "#cdced0",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#f0eded",
                        "on-secondary-fixed": "#191c20",
                        "on-error-container": "#93000a",
                        "on-surface-variant": "#59413f",
                        "on-primary-fixed": "#410005",
                        "on-secondary-fixed-variant": "#45474c",
                        "on-secondary-container": "#626469",
                        "on-secondary": "#ffffff",
                        "inverse-primary": "#ffb3ae",
                        "surface-bright": "#fcf9f8",
                        "on-primary": "#ffffff",
                        "tertiary": "#3e4142",
                        "on-tertiary-fixed": "#191c1e",
                        "surface-container-low": "#f6f3f2",
                        "tertiary-fixed-dim": "#c5c7c8"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "max_width": "1440px",
                        "gutter": "24px",
                        "lg": "40px",
                        "md": "24px",
                        "margin": "32px",
                        "base": "4px",
                        "xs": "8px",
                        "xl": "64px",
                        "sm": "16px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "title-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "title-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "title-md": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "600"}]
                    }
                },
            },
        }
    }catch(_e){}</script>
    <title>Company News - Elsewedy Development</title>
</head>
<body class="bg-background text-on-background font-body-lg min-h-screen flex flex-col overflow-x-hidden">
<!-- TopNavBar -->
<header class="bg-surface dark:bg-surface-container border-b border-outline-variant sticky top-0 z-50">
<div class="flex justify-between items-center px-gutter w-full h-16 max-w-max_width mx-auto">
<div class="flex items-center gap-md">
<a href="/" class="flex items-center gap-sm cursor-pointer active:scale-95 transition-transform">
<img src="https://elsewedydevelopment.com/wp-content/uploads/2023/04/SD-web-Logo.png" alt="Elsewedy Development" class="h-9 object-contain">
<span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim hidden sm:inline">
    Company News
</span>
</a>
</div>
<div class="flex items-center gap-sm">
<div class="hidden sm:flex relative group">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
<input id="news-search" class="bg-surface-container-low border border-outline-variant rounded-full pl-10 pr-4 py-2 w-64 text-body-md focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="Search news..." type="text">
</div>
<a href="/logout" class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors" title="Logout">
<span class="material-symbols-outlined text-secondary">logout</span>
</a>
</div>
</div>
</header>
<div class="flex flex-1 max-w-max_width mx-auto w-full">
<!-- SideNavBar -->
<aside class="hidden lg:flex flex-col h-[calc(100vh-4rem)] sticky top-16 py-md px-sm gap-xs bg-surface-container-low border-r border-outline-variant w-64 shrink-0">
<div class="mb-md px-sm">
<p class="font-title-md text-title-md font-bold text-on-surface">Elsewedy Portal</p>
<p class="font-label-md text-label-md text-secondary">News & Updates</p>
</div>
<nav class="flex flex-col gap-1">
<a class="flex items-center gap-sm px-sm py-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all duration-200 ease-in-out" href="/">
<span class="material-symbols-outlined">home</span>
<span class="font-label-md text-label-md">Home</span>
</a>
<a class="flex items-center gap-sm px-sm py-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all duration-200 ease-in-out" href="/serviceReq">
<span class="material-symbols-outlined">history</span>
<span class="font-label-md text-label-md">Knowledge Base</span>
</a>
<a class="flex items-center gap-sm px-sm py-2 bg-secondary-container text-on-secondary-container rounded-lg font-semibold transition-all duration-200 ease-in-out" href="/news">
<span class="material-symbols-outlined">newspaper</span>
<span class="font-label-md text-label-md">News</span>
</a>
<% if (user && user.role === 'admin') { %>
<a class="flex items-center gap-sm px-sm py-2 text-on-surface-variant rounded-lg hover:bg-surface-variant transition-all duration-200 ease-in-out" href="/admin/services">
<span class="material-symbols-outlined">dashboard</span>
<span class="font-label-md text-label-md">My Articles</span>
</a>
<a class="flex items-center gap-sm px-sm py-2 text-on-surface-variant rounded-lg hover:bg-surface-variant transition-all duration-200 ease-in-out" href="/admin/news">
<span class="material-symbols-outlined">admin_panel_settings</span>
<span class="font-label-md text-label-md">Manage News</span>
</a>
<% } %>
</nav>
</aside>
<!-- Main Content -->
<main class="flex-1 px-gutter py-xl max-w-5xl mx-auto w-full">
<div class="mb-xl">
<h1 class="font-headline-lg text-headline-lg text-on-background">Latest Company News</h1>
<p class="font-body-md text-body-md text-secondary mt-1">
Browse all company announcements, press releases, and news items.
</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md" id="news-grid">
<% if (newsItems && newsItems.length > 0) { %>
<% newsItems.forEach((item) => { %>
<article class="bg-surface border border-outline-variant rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col h-full group" data-news-item data-title="<%= stripHtml(item.title || '') %>" data-content="<%= stripHtml(item.content || '') %>">
<img src="<%= item.imageUrl %>" alt="<%= stripHtml(item.title || '') %>" class="w-full h-44 object-cover group-hover:scale-[1.02] transition-transform duration-300">
<div class="p-md flex flex-col flex-1">
<div class="flex items-center gap-xs text-primary font-label-md text-label-md font-semibold mb-xs">
<span class="material-symbols-outlined text-[16px]">calendar_month</span>
<span>Added on: <%= new Date(item.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
</div>
<h2 class="font-title-lg text-title-lg text-on-surface mb-sm group-hover:text-primary transition-colors line-clamp-2">
<%= stripHtml(item.title || '') %>
</h2>
<p class="font-body-md text-body-md text-secondary mb-lg flex-1 line-clamp-3">
<%= stripHtml(item.content || '') %>
</p>
<div class="pt-md border-t border-outline-variant flex items-center justify-between mt-auto">
<a href="/news/<%= item._id %>" class="px-md py-xs bg-primary text-on-primary rounded-lg font-title-md text-title-md hover:bg-primary-container transition-all">
Read Full Article
</a>
</div>
</div>
</article>
<% }); %>
<% } else { %>
<div class="col-span-full text-center py-xl">
<span class="material-symbols-outlined text-[48px] text-secondary mx-auto mb-md opacity-50">newspaper</span>
<h3 class="font-title-lg text-title-lg text-on-surface">No news articles published yet</h3>
<p class="font-body-md text-body-md text-secondary">Check back soon for latest announcements!</p>
</div>
<% } %>
</div>
</main>
</div>
<script>
const newsSearch = document.getElementById('news-search');
newsSearch?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    const items = document.querySelectorAll('[data-news-item]');
    items.forEach(item => {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        const content = (item.getAttribute('data-content') || '').toLowerCase();
        const matches = title.includes(query) || content.includes(query);
        item.style.display = matches ? '' : 'none';
    });
});
</script>
<!-- Footer -->
<footer class="bg-surface border-t border-outline-variant mt-auto py-md text-center text-secondary text-sm">
  © <%= currentYear %> Elsewedy Development. All rights reserved.
</footer>
</body>
</html>