    <title><%= service ? 'Edit' : 'Create' %> Article - Elsewedy Development</title>
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.1/tinymce.min.js" referrerpolicy="origin"></script>
    <style>
      .tox-tinymce { border-radius: 0.5rem !important; border-color: #8d706e !important; }
      .rich-editor-wrap { min-width: 0; }
    </style>
</head>
<body class="bg-[#F5F6F8] text-on-surface font-body-lg min-h-screen flex flex-col">
<!-- TopNavBar -->
<header class="bg-surface dark:bg-surface-container border-b border-outline-variant dark:border-outline sticky top-0 z-50">
<div class="flex justify-between items-center px-gutter w-full h-16 max-w-max_width mx-auto">
<div class="flex items-center gap-sm">
<button id="sidebar-toggle-btn" type="button" class="p-2 -ml-2 rounded-lg text-on-surface hover:bg-surface-variant transition-colors flex items-center justify-center focus:outline-none cursor-pointer" aria-label="Toggle Navigation Menu" title="Toggle Sidebar">
<span class="material-symbols-outlined text-2xl" data-icon="menu">menu</span>
</button>
<a href="/" class="flex items-center gap-sm cursor-pointer active:scale-95 transition-transform">
<img src="https://elsewedydevelopment.com/wp-content/uploads/2023/04/SD-web-Logo.png" alt="Elsewedy Development" class="h-9 object-contain">
<span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim hidden sm:inline"><%= service ? 'Edit' : 'Create' %> Article</span>
</a>
</div>
<div class="flex items-center gap-sm">
                <!-- Notifications and settings icons removed -->
                <div class="h-8 w-[1px] bg-outline-variant mx-2"></div>
<a href="/admin/services" class="bg-primary text-on-primary px-sm py-xs rounded-lg font-title-md hover:bg-primary-container transition-all active:scale-95">Back</a>
<a href="/logout" class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors" title="Logout">
<span class="material-symbols-outlined text-secondary">logout</span>
</a>
</div>
</div>
</header>
<!-- Sidebar Backdrop Overlay -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity duration-300 backdrop-blur-sm cursor-pointer"></div>

<div class="flex flex-1 max-w-max_width mx-auto w-full">
<!-- Interactive SideNavBar Drawer -->
<aside id="app-sidebar" class="fixed top-16 left-0 bottom-0 z-50 w-64 py-md px-sm flex flex-col gap-xs bg-surface-container-low dark:bg-surface-container-lowest border-r border-outline-variant dark:border-outline transition-transform duration-300 ease-in-out -translate-x-full shadow-2xl overflow-y-auto">
<div class="mb-lg px-2 flex items-center justify-between">
<div>
<h2 class="font-title-md text-title-md font-bold text-on-surface">CRM Admin</h2>
<p class="font-label-md text-label-md text-secondary">Knowledge Management</p>
</div>
<button id="sidebar-close-btn" type="button" class="p-1 rounded-lg text-secondary hover:text-primary hover:bg-surface-variant transition-colors" title="Close Menu">
<span class="material-symbols-outlined text-xl">close</span>
</button>
</div>
<nav class="flex flex-col gap-1">
<a class="flex items-center gap-sm px-sm py-2 rounded-lg text-on-surface-variant hover:bg-surface-variant transition-all duration-200" href="/">
<span class="material-symbols-outlined">home</span>
<span class="font-label-md text-label-md">Home</span>
</a>
<a class="flex items-center gap-sm px-sm py-2 rounded-lg text-on-surface-variant hover:bg-surface-variant transition-all duration-200" href="/serviceReq">
<span class="material-symbols-outlined">history</span>
<span class="font-label-md text-label-md">Employee book</span>
</a>
<a class="flex items-center gap-sm px-sm py-2 rounded-lg bg-secondary-container text-on-secondary-container font-semibold transition-all duration-200" href="/admin/services/new">
<span class="material-symbols-outlined">add_note</span>
<span class="font-label-md text-label-md">New Article</span>
</a>
</nav>
<a class="mt-lg mx-2 bg-primary text-on-primary py-xs px-sm rounded-lg font-title-md shadow-md hover:shadow-lg transition-all active:scale-95 text-center" href="/admin/services">Services List</a>
<div class="mt-auto pt-md border-t border-outline-variant">
</div>
</aside>
<!-- Main Content -->
<main class="flex-1 p-gutter max-w-5xl mx-auto w-full min-w-0">
<header class="mb-lg">
<h1 class="font-headline-lg text-headline-lg text-on-surface mb-2"><%= service ? '✏️ Edit Article' : '✨ Create New Article' %></h1>
<p class="font-body-md text-body-md text-secondary">Fill in the details below to add a new employee book article to the Employee book.</p>
</header>
<form class="space-y-md" id="article-form" method="POST" action="<%= service ? '/admin/services/' + service._id + '/edit' : '/admin/services' %>">
<!-- Section 1: Title & Description -->
<section class="form-card bg-surface-container-lowest p-md rounded-[12px] border border-outline-variant min-w-0 overflow-hidden">
<div class="mb-sm min-w-0">
<label class="block font-title-md text-title-md text-secondary mb-xs" for="name">Article Title</label>
<textarea 
class="w-full px-sm py-sm rounded-lg border border-outline bg-[#F5F6F8] focus:bg-white focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none" 
id="name" 
name="name"
placeholder="e.g., General request" 
rows="2"
required><%= service ? service.name : '' %></textarea>
</div>
<div class="mb-sm min-w-0">
<div class="min-w-0">
<label class="block font-title-md text-title-md text-secondary mb-xs" for="description">Description (Short Summary)</label>
<p class="font-label-md text-label-md text-secondary mb-xs">Use the toolbar above the text to change font, size, bold, color, and more.</p>
<textarea 
id="description" 
name="description"
rows="4"><%= service && service.description ? service.description : '' %></textarea>
</div>
</div>
</section>
<!-- Section 2: Detailed Content -->
<section class="form-card bg-surface-container-lowest p-md rounded-[12px] border border-outline-variant min-w-0 overflow-hidden">
<div class="mb-md">
<h3 class="font-title-lg text-title-lg text-on-surface">Detailed Content</h3>
<p class="font-label-md text-label-md text-secondary mt-xs">Choose how you want to write the detailed content.</p>
</div>

<% const currentLayout = (service && service.detailsLayout) ? service.detailsLayout : 'steps'; %>
<input type="hidden" id="detailsLayout" name="detailsLayout" value="<%= currentLayout %>">

<div class="grid grid-cols-1 md:grid-cols-3 gap-sm mb-md" id="layout-choices">
<button type="button" data-layout-choice="bulk" class="layout-choice text-left p-sm rounded-xl border-2 transition-all <%= currentLayout === 'bulk' ? 'border-primary bg-primary-fixed' : 'border-outline-variant bg-white hover:border-primary' %>">
<span class="material-symbols-outlined text-primary mb-xs block">article</span>
<span class="font-title-md text-title-md text-on-surface block">Bulk content</span>
<span class="font-label-md text-label-md text-secondary">One formatted text block with Word toolbar</span>
</button>
<button type="button" data-layout-choice="steps" class="layout-choice text-left p-sm rounded-xl border-2 transition-all <%= currentLayout === 'steps' ? 'border-primary bg-primary-fixed' : 'border-outline-variant bg-white hover:border-primary' %>">
<span class="material-symbols-outlined text-primary mb-xs block">format_list_numbered</span>
<span class="font-title-md text-title-md text-on-surface block">Steps content</span>
<span class="font-label-md text-label-md text-secondary">Numbered steps with department + content</span>
</button>
<button type="button" data-layout-choice="both" class="layout-choice text-left p-sm rounded-xl border-2 transition-all <%= currentLayout === 'both' ? 'border-primary bg-primary-fixed' : 'border-outline-variant bg-white hover:border-primary' %>">
<span class="material-symbols-outlined text-primary mb-xs block">view_agenda</span>
<span class="font-title-md text-title-md text-on-surface block">Bulk + Steps</span>
<span class="font-label-md text-label-md text-secondary">Bulk text first, then numbered steps</span>
</button>
</div>

<div id="bulk-panel" class="mb-md min-w-0 <%= currentLayout === 'steps' ? 'hidden' : '' %>">
<label class="block font-title-md text-title-md text-secondary mb-xs" for="bulkContent">Bulk Content</label>
<p class="font-label-md text-label-md text-secondary mb-xs">Use the Word-like toolbar to bold, align, change fonts, colors, and more.</p>
<textarea id="bulkContent" name="bulkContent" rows="8"><%= service && service.bulkContent ? service.bulkContent : '' %></textarea>
</div>

<div id="steps-panel" class="min-w-0 <%= currentLayout === 'bulk' ? 'hidden' : '' %>">
<label class="block font-title-md text-title-md text-secondary mb-xs">Steps</label>
<p class="font-label-md text-label-md text-secondary mb-sm">Each step Content box has a Word-like toolbar.</p>
<div id="detail-cards" class="space-y-sm min-w-0"></div>
</div>

<input type="hidden" id="details" name="details" value="">
</section>
<!-- Submit Actions -->
<div class="flex justify-end gap-sm pt-md">
<a class="px-xl py-xs rounded-lg border border-outline font-title-md text-secondary hover:bg-surface-variant transition-all" href="/admin/services">Cancel</a>
<button class="px-xl py-xs rounded-lg bg-[#850515] text-white font-title-md hover:opacity-90 shadow-lg active:scale-95 transition-all" type="submit"><%= service ? '💾 Update Article' : '✨ Create Article' %></button>
</div>
</form>
</main>
</div>
<!-- Footer -->
<footer class="bg-surface dark:bg-surface-container border-t border-outline-variant dark:border-outline mt-auto"></footer>

<script type="application/json" id="initial-service-data">
  <%- JSON.stringify({
    details: service ? service.details : '',
    detailsLayout: (service && service.detailsLayout) ? service.detailsLayout : 'steps'
  }) %>
</script>

<script>
  const detailCardsContainer = document.getElementById('detail-cards');
  const detailsHiddenInput = document.getElementById('details');
  const detailsLayoutInput = document.getElementById('detailsLayout');
  const bulkPanel = document.getElementById('bulk-panel');
  const stepsPanel = document.getElementById('steps-panel');
  const articleForm = document.getElementById('article-form');
  const serviceData = JSON.parse(document.getElementById('initial-service-data')?.textContent || '{}');
  const initialDetailsValue = serviceData.details || '';
  const initialLayout = serviceData.detailsLayout || 'steps';
  let editorSeq = 0;
  let stepsInitialized = false;
  let bulkEditorReady = false;

  const editorToolbar =
    'undo redo | formatselect fontfamily fontsize | bold italic underline strikethrough subscript superscript | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link code charmap | removeformat';

  const sharedEditorOptions = {
    base_url: 'https://cdn.jsdelivr.net/npm/tinymce@7.6.1',
    suffix: '.min',
    menubar: 'edit view insert format',
    plugins: 'lists link table wordcount charmap fullscreen code',
    toolbar: editorToolbar,
    font_family_formats:
      'Arial=arial,helvetica,sans-serif; Times New Roman=times new roman,times,serif; Georgia=georgia,palatino,serif; Courier New=courier new,courier,monospace; Verdana=verdana,geneva,sans-serif; Tahoma=tahoma,arial,helvetica,sans-serif; Comic Sans MS=comic sans ms,sans-serif',
    font_size_formats: '8px 10px 12px 14px 16px 18px 20px 24px 30px 36px 42px 48px',
    block_formats: 'Paragraph=p; Heading 1=h1; Heading 2=h2; Heading 3=h3; Heading 4=h4; Heading 5=h5; Heading 6=h6; Preformatted=pre',
    branding: false,
    promotion: false,
    convert_urls: false,
    content_style:
      'body { font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; word-break: break-word; } h1 { font-size: 32px; font-weight: bold; margin: 0.5em 0; } h2 { font-size: 28px; font-weight: bold; margin: 0.5em 0; } h3 { font-size: 24px; font-weight: bold; margin: 0.5em 0; }'
  };

  function parseDetailsValue(value) {
    if (!value || !String(value).trim()) {
      return [{ department: '', content: '' }];
    }

    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) {
        const steps = parsed.map((step) => ({
          department: step.department || '',
          content: step.content || ''
        }));
        return steps.length ? steps : [{ department: '', content: '' }];
      }
    } catch (_err) {}

    const sections = String(value).split(/\n\s*\n/).filter(Boolean);
    if (!sections.length) return [{ department: '', content: '' }];

    return sections.map((section) => {
      const lines = section.split(/\r?\n/).map((line) => line.trim());
      const firstLine = lines[0] || '';
      const numberedMatch = firstLine.match(/^(\d+)\.\s*(.*)$/);
      const departmentLine = lines.find((line) => /^department:/i.test(line));
      const department = departmentLine ? departmentLine.replace(/^department:/i, '').trim() : '';
      const contentLines = lines.filter((line, index) => {
        if (index === 0 && numberedMatch) return false;
        const trimmed = line.trim();
        if (!trimmed) return false;
        if (/^department:/i.test(trimmed) || /^content:/i.test(trimmed)) return false;
        return true;
      });
      const content = contentLines.join('\n').trim();
      return { department, content: content || section.trim() };
    });
  }

  function getEditorHtml(textarea) {
    if (!textarea) return '';
    const editor = window.tinymce && tinymce.get(textarea.id);
    if (editor) return editor.getContent().trim();
    return textarea.value.trim();
  }

  function stripHtmlClient(html) {
    const tmp = document.createElement('div');
    tmp.innerHTML = html || '';
    return (tmp.textContent || tmp.innerText || '').replace(/\s+/g, ' ').trim();
  }

  function isEmptyHtml(html) {
    return !stripHtmlClient(html);
  }

  function getCurrentLayout() {
    return detailsLayoutInput.value || 'steps';
  }

  function buildDetailsValue() {
    const layout = getCurrentLayout();
    if (layout === 'bulk') return '';

    const cards = Array.from(detailCardsContainer.querySelectorAll('[data-detail-card]'))
      .map((card) => {
        const departmentEl = card.querySelector('[data-detail-department]');
        const contentEl = card.querySelector('[data-detail-content]');
        return {
          department: (departmentEl?.value || '').trim(),
          content: getEditorHtml(contentEl)
        };
      })
      .filter((card) => card.department || !isEmptyHtml(card.content));

    if (cards.length === 0) return '';
    return JSON.stringify(cards);
  }

  function updateCardNumbers() {
    detailCardsContainer.querySelectorAll('[data-card-number]').forEach((label, index) => {
      label.textContent = index + 1;
    });
  }

  function syncDetailsValue() {
    detailsHiddenInput.value = buildDetailsValue();
  }

  function initRichEditor(selector, height, onChange) {
    return tinymce.init({
      ...sharedEditorOptions,
      selector,
      height,
      setup(editor) {
        editor.on('change keyup undo redo SetContent', () => {
          editor.save();
          if (onChange) onChange();
        });
      }
    });
  }

  function destroyEditor(textareaId) {
    const editor = window.tinymce && tinymce.get(textareaId);
    if (editor) editor.remove();
  }

  function updateLayoutChoiceStyles(layout) {
    document.querySelectorAll('[data-layout-choice]').forEach((btn) => {
      const active = btn.getAttribute('data-layout-choice') === layout;
      btn.classList.toggle('border-primary', active);
      btn.classList.toggle('bg-primary-fixed', active);
      btn.classList.toggle('border-outline-variant', !active);
      btn.classList.toggle('bg-white', !active);
    });
  }

  async function ensureBulkEditor() {
    if (bulkEditorReady || tinymce.get('bulkContent')) {
      bulkEditorReady = true;
      return;
    }
    await initRichEditor('#bulkContent', 280, null);
    bulkEditorReady = true;
  }

  function ensureStepsEditors() {
    if (stepsInitialized) return;
    renderDetailCards(parseDetailsValue(initialDetailsValue));
    stepsInitialized = true;
  }

  async function applyLayout(layout) {
    detailsLayoutInput.value = layout;
    updateLayoutChoiceStyles(layout);

    const showBulk = layout === 'bulk' || layout === 'both';
    const showSteps = layout === 'steps' || layout === 'both';

    bulkPanel.classList.toggle('hidden', !showBulk);
    stepsPanel.classList.toggle('hidden', !showSteps);

    if (showBulk) await ensureBulkEditor();
    if (showSteps) ensureStepsEditors();

    syncDetailsValue();
  }

  function createDetailCard(index, step = { department: '', content: '' }) {
    editorSeq += 1;
    const contentId = `detail-content-${editorSeq}`;
    const card = document.createElement('div');
    card.className = 'rounded-xl border border-outline-variant bg-[#F5F6F8] p-sm space-y-sm min-w-0 overflow-hidden';
    card.dataset.detailCard = 'true';
    card.innerHTML = `
      <div class="flex items-center justify-between gap-sm">
        <label class="font-title-md text-title-md text-secondary">Step <span data-card-number>${index}</span></label>
        <button type="button" class="text-sm text-primary hover:underline" data-remove-card>Remove</button>
      </div>
      <div class="min-w-0">
        <label class="block font-title-md text-title-md text-secondary mb-xs" for="detail-department-${editorSeq}">Department</label>
        <textarea class="w-full min-h-[44px] px-sm py-sm rounded-lg border border-outline bg-white focus:border-primary focus:ring-1 focus:ring-primary outline-none resize-y" id="detail-department-${editorSeq}" data-detail-department rows="2" placeholder="e.g. Finance" style="overflow-wrap: anywhere; word-break: break-word; white-space: pre-wrap;"></textarea>
      </div>
      <div class="min-w-0 rich-editor-wrap">
        <label class="block font-title-md text-title-md text-secondary mb-xs" for="${contentId}">Content</label>
        <textarea id="${contentId}" data-detail-content></textarea>
      </div>
      <div class="pt-xs">
        <button type="button" class="text-sm text-primary hover:underline" data-add-step>+ Add another step</button>
      </div>
    `;

    const removeButton = card.querySelector('[data-remove-card]');
    const addStepButton = card.querySelector('[data-add-step]');
    const departmentInput = card.querySelector('[data-detail-department]');
    const contentInput = card.querySelector('[data-detail-content]');

    departmentInput.value = step.department || '';
    contentInput.value = step.content || '';

    removeButton.addEventListener('click', () => {
      if (detailCardsContainer.querySelectorAll('[data-detail-card]').length > 1) {
        destroyEditor(contentId);
        card.remove();
        updateCardNumbers();
        syncDetailsValue();
      }
    });

    addStepButton.addEventListener('click', () => {
      const currentCards = Array.from(detailCardsContainer.querySelectorAll('[data-detail-card]'));
      const newCard = createDetailCard(currentCards.length + 1, { department: '', content: '' });
      detailCardsContainer.appendChild(newCard);
      updateCardNumbers();
      syncDetailsValue();
    });

    departmentInput.addEventListener('input', syncDetailsValue);
    initRichEditor(`#${contentId}`, 220, syncDetailsValue);
    return card;
  }

  function renderDetailCards(cards) {
    detailCardsContainer.querySelectorAll('[data-detail-content]').forEach((el) => destroyEditor(el.id));
    detailCardsContainer.innerHTML = '';
    cards.forEach((card, index) => {
      detailCardsContainer.appendChild(createDetailCard(index + 1, card));
    });
    updateCardNumbers();
    syncDetailsValue();
  }

  document.querySelectorAll('[data-layout-choice]').forEach((btn) => {
    btn.addEventListener('click', () => {
      applyLayout(btn.getAttribute('data-layout-choice'));
    });
  });

  initRichEditor('#name', 160, null);
  initRichEditor('#description', 240, null).then(() => applyLayout(initialLayout));

  articleForm.addEventListener('submit', () => {
    if (window.tinymce) tinymce.triggerSave();
    syncDetailsValue();
    const layout = getCurrentLayout();
    if (layout === 'steps') {
      const bulkEl = document.getElementById('bulkContent');
      if (bulkEl) bulkEl.value = '';
      const bulkEditor = tinymce.get('bulkContent');
      if (bulkEditor) bulkEditor.setContent('');
    }
    if (layout === 'bulk') {
      detailsHiddenInput.value = '';
    }
  });

  // Interactive Sidebar Toggle Logic
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const closeBtn = document.getElementById('sidebar-close-btn');
  const sidebar = document.getElementById('app-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');

  if (sidebar) {
    const openSidebar = () => {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      if (backdrop) backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    const closeSidebar = () => {
      sidebar.classList.remove('translate-x-0');
      sidebar.classList.add('-translate-x-full');
      if (backdrop) backdrop.classList.add('hidden');
      document.body.style.overflow = '';
    };

    if (toggleBtn) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = sidebar.classList.contains('translate-x-0');
        if (isOpen) closeSidebar();
        else openSidebar();
      });
    }

    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (backdrop) backdrop.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar.classList.contains('translate-x-0')) {
        closeSidebar();
      }
    });

    const navLinks = sidebar.querySelectorAll('a');
    navLinks.forEach(link => {
      link.addEventListener('click', closeSidebar);
    });
  }
</script>
</body>
</html>