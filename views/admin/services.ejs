<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">try{
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-tertiary": "#ffffff",
                    "tertiary-fixed": "#e1e2e4",
                    "primary-fixed-dim": "#ffb3ae",
                    "on-background": "#1b1c1c",
                    "outline": "#8d706e",
                    "on-tertiary-fixed-variant": "#444749",
                    "secondary-fixed-dim": "#c5c6cc",
                    "secondary": "#5c5e63",
                    "primary-container": "#a72429",
                    "surface": "#fcf9f8",
                    "tertiary-container": "#55585a",
                    "error-container": "#ffdad6",
                    "on-error": "#ffffff",
                    "secondary-container": "#e1e2e8",
                    "on-surface": "#1b1c1c",
                    "secondary-fixed": "#e1e2e8",
                    "on-primary-fixed-variant": "#8f0f1a",
                    "primary": "#850515",
                    "surface-dim": "#dcd9d9",
                    "background": "#fcf9f8",
                    "surface-variant": "#e5e2e1",
                    "on-primary-container": "#ffbeba",
                    "error": "#ba1a1a",
                    "inverse-on-surface": "#f3f0ef",
                    "outline-variant": "#e1bfbc",
                    "surface-tint": "#b12b2f",
                    "surface-container-highest": "#e5e2e1",
                    "surface-container-high": "#eae7e7",
                    "primary-fixed": "#ffdad7",
                    "inverse-surface": "#303030",
                    "on-tertiary-container": "#cdced0",
                    "surface-container-lowest": "#ffffff",
                    "surface-container": "#f0eded",
                    "on-secondary-fixed": "#191c20",
                    "on-error-container": "#93000a",
                    "on-surface-variant": "#59413f",
                    "on-primary-fixed": "#410005",
                    "on-secondary-fixed-variant": "#45474c",
                    "on-secondary-container": "#626469",
                    "on-secondary": "#ffffff",
                    "inverse-primary": "#ffb3ae",
                    "surface-bright": "#fcf9f8",
                    "on-primary": "#ffffff",
                    "tertiary": "#3e4142",
                    "on-tertiary-fixed": "#191c1e",
                    "surface-container-low": "#f6f3f2",
                    "tertiary-fixed-dim": "#c5c7c8"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "2xl": "1rem",
                    "full": "9999px"
            },
            "spacing": {
                    "max_width": "1440px",
                    "gutter": "24px",
                    "lg": "40px",
                    "md": "24px",
                    "margin": "32px",
                    "base": "4px",
                    "xs": "8px",
                    "xl": "64px",
                    "sm": "16px"
            },
            "fontFamily": {
                    "body-lg": ["Inter"],
                    "title-md": ["Inter"],
                    "headline-lg": ["Inter"],
                    "headline-md": ["Inter"],
                    "display-lg": ["Inter"],
                    "label-md": ["Inter"],
                    "body-md": ["Inter"],
                    "title-lg": ["Inter"]
            },
            "fontSize": {
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "title-md": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                    "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "600"}]
            }
          },
        },
      }
    }catch(_e){}</script>
    <title>Manage Knowledge Articles - Elsewedy Development</title>
</head>
<body class="bg-background text-on-background font-body-lg min-h-screen flex flex-col">
<!-- TopNavBar -->
<header class="bg-surface dark:bg-surface-container border-b border-outline-variant dark:border-outline sticky top-0 z-50">
<div class="flex justify-between items-center px-gutter w-full h-16 max-w-max_width mx-auto">
<div class="flex items-center gap-md">
<a href="/" class="flex items-center gap-sm cursor-pointer active:scale-95 transition-transform">
<img src="https://elsewedydevelopment.com/wp-content/uploads/2023/04/SD-web-Logo.png" alt="Elsewedy Development" class="h-9 object-contain">
<span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim hidden sm:inline">Manage Articles</span>
</a>
</div>
<div class="flex items-center gap-sm">
<a href="/admin/services/new" class="bg-primary text-on-primary px-sm py-xs rounded-lg font-title-md hover:bg-primary-container transition-all active:scale-95 flex items-center gap-xs">
<span class="material-symbols-outlined">add</span>
New Article
</a>
<a href="/logout" class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors" title="Logout">
<span class="material-symbols-outlined text-secondary">logout</span>
</a>
</div>
</div>
</header>
<div class="flex flex-1 max-w-max_width mx-auto w-full">
<!-- SideNavBar -->
<aside class="hidden lg:flex flex-col h-[calc(100vh-64px)] py-md px-sm gap-xs bg-surface-container-low dark:bg-surface-container-lowest border-r border-outline-variant dark:border-outline w-64 sticky top-16">
<div class="px-sm mb-md">
<div class="flex items-center gap-sm mb-xs">
<div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-on-primary">corporate_fare</span>
</div>
<span class="font-title-md text-title-md font-bold text-on-surface">Elsewedy Portal</span>
</div>
<p class="font-label-md text-label-md text-secondary opacity-70">Knowledge Management</p>
</div>
<nav class="flex-1 flex flex-col gap-xs">
<a class="flex items-center gap-sm px-sm py-base text-on-surface-variant hover:bg-surface-variant rounded-lg font-label-md text-label-md duration-200 ease-in-out transition-all" href="/">
<span class="material-symbols-outlined">home</span>
Home
</a>
<a class="flex items-center gap-sm px-sm py-base text-on-surface-variant hover:bg-surface-variant rounded-lg font-label-md text-label-md duration-200 ease-in-out transition-all" href="/serviceReq">
<span class="material-symbols-outlined">history</span>
Knowledge Base
</a>
<a class="flex items-center gap-sm px-sm py-base text-on-surface-variant hover:bg-surface-variant rounded-lg font-label-md text-label-md duration-200 ease-in-out transition-all" href="/news">
<span class="material-symbols-outlined">newspaper</span>
News
</a>
<a class="flex items-center gap-sm px-sm py-base bg-secondary-container text-on-secondary-container rounded-lg font-label-md text-label-md duration-200 ease-in-out transition-all font-semibold" href="/admin/services">
<span class="material-symbols-outlined">dashboard</span>
My Articles
</a>
<a class="flex items-center gap-sm px-sm py-base text-on-surface-variant hover:bg-surface-variant rounded-lg font-label-md text-label-md duration-200 ease-in-out transition-all" href="/admin/news">
<span class="material-symbols-outlined">admin_panel_settings</span>
Manage News
</a>
</nav>
</aside>
<!-- Main Content -->
<main class="flex-1 p-gutter max-w-6xl mx-auto w-full">
<div class="mb-lg">
<div class="flex justify-between items-start mb-md">
<div>
<h1 class="font-headline-lg text-headline-lg text-on-background mb-sm">Knowledge Base Articles</h1>
<p class="font-body-md text-body-md text-secondary">Manage all articles and knowledge base content</p>
</div>
<a href="/admin/services/new" class="bg-primary text-on-primary px-lg py-sm rounded-lg font-title-md hover:bg-primary-container transition-all active:scale-95 flex items-center gap-xs">
<span class="material-symbols-outlined">add</span>
Create Article
</a>
</div>
</div>
<% if (services && services.length > 0) { %>
<!-- Services Table -->
<div class="bg-surface border border-outline-variant rounded-xl shadow-sm overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full">
<thead>
<tr class="bg-surface-container-low border-b border-outline-variant">
<th class="text-left px-md py-sm font-title-md text-title-md text-on-surface">Article Title</th>
<th class="text-left px-md py-sm font-title-md text-title-md text-on-surface">Actions</th>
</tr>
</thead>
<tbody>
<% services.forEach(service => { %>
<tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
<td class="px-md py-sm font-body-md text-body-md text-on-surface font-semibold">
<%= service.name %>
</td>
<td class="px-md py-sm">
<div class="flex items-center gap-xs">
<a href="/admin/services/<%= service._id %>/edit" class="flex items-center gap-xs px-sm py-xs rounded-lg font-label-md text-label-md text-primary hover:bg-surface-variant transition-all">
<span class="material-symbols-outlined text-[18px]">edit</span>
Edit
</a>
<form method="POST" action="/admin/services/<%= service._id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this article?');">
<button type="submit" class="flex items-center gap-xs px-sm py-xs rounded-lg font-label-md text-label-md text-error hover:bg-error-container transition-all">
<span class="material-symbols-outlined text-[18px]">delete</span>
Delete
</button>
</form>
</div>
</td>
</tr>
<% }); %>
</tbody>
</table>
</div>
</div>
<% } else { %>
<!-- Empty State -->
<div class="text-center py-xl">
<span class="material-symbols-outlined text-[64px] text-secondary mx-auto mb-md opacity-50">description</span>
<h3 class="font-headline-md text-headline-md text-on-surface mb-sm">No articles yet</h3>
<p class="font-body-md text-body-md text-secondary mb-lg">Create your first knowledge base article to get started.</p>
<a href="/admin/services/new" class="inline-flex items-center gap-xs bg-primary text-on-primary px-lg py-sm rounded-lg font-title-md hover:bg-primary-container transition-all">
<span class="material-symbols-outlined">add</span>
Create Article
</a>
</div>
<% } %>
</main>
</div>
<!-- Footer -->
<footer class="bg-surface dark:bg-surface-container border-t border-outline-variant dark:border-outline mt-auto">
<div class="flex flex-col md:flex-row justify-between items-center py-lg px-gutter w-full max-w-max_width mx-auto gap-md">
<span class="font-label-md text-label-md text-secondary">© <%= currentYear %> Oracle CRM Knowledge Base. Internal Use Only.</span>
</div>
</footer>
</body>
</html>