<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">try{
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-tertiary": "#ffffff",
                    "tertiary-fixed": "#e1e2e4",
                    "primary-fixed-dim": "#ffb3ae",
                    "on-background": "#1b1c1c",
                    "outline": "#8d706e",
                    "on-tertiary-fixed-variant": "#444749",
                    "secondary-fixed-dim": "#c5c6cc",
                    "secondary": "#5c5e63",
                    "primary-container": "#a72429",
                    "surface": "#fcf9f8",
                    "tertiary-container": "#55585a",
                    "error-container": "#ffdad6",
                    "on-error": "#ffffff",
                    "secondary-container": "#e1e2e8",
                    "on-surface": "#1b1c1c",
                    "secondary-fixed": "#e1e2e8",
                    "on-primary-fixed-variant": "#8f0f1a",
                    "primary": "#850515",
                    "surface-dim": "#dcd9d9",
                    "background": "#fcf9f8",
                    "surface-variant": "#e5e2e1",
                    "on-primary-container": "#ffbeba",
                    "error": "#ba1a1a",
                    "inverse-on-surface": "#f3f0ef",
                    "outline-variant": "#e1bfbc",
                    "surface-tint": "#b12b2f",
                    "surface-container-highest": "#e5e2e1",
                    "surface-container-high": "#eae7e7",
                    "primary-fixed": "#ffdad7",
                    "inverse-surface": "#303030",
                    "on-tertiary-container": "#cdced0",
                    "surface-container-lowest": "#ffffff",
                    "surface-container": "#f0eded",
                    "on-secondary-fixed": "#191c20",
                    "on-error-container": "#93000a",
                    "on-surface-variant": "#59413f",
                    "on-primary-fixed": "#410005",
                    "on-secondary-fixed-variant": "#45474c",
                    "on-secondary-container": "#626469",
                    "on-secondary": "#ffffff",
                    "inverse-primary": "#ffb3ae",
                    "surface-bright": "#fcf9f8",
                    "on-primary": "#ffffff",
                    "tertiary": "#3e4142",
                    "on-tertiary-fixed": "#191c1e",
                    "surface-container-low": "#f6f3f2",
                    "tertiary-fixed-dim": "#c5c7c8"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "2xl": "1rem",
                    "full": "9999px"
            },
            "spacing": {
                    "max_width": "1440px",
                    "gutter": "24px",
                    "lg": "40px",
                    "md": "24px",
                    "margin": "32px",
                    "base": "4px",
                    "xs": "8px",
                    "xl": "64px",
                    "sm": "16px"
            },
            "fontFamily": {
                    "body-lg": ["Inter"],
                    "title-md": ["Inter"],
                    "headline-lg": ["Inter"],
                    "headline-md": ["Inter"],
                    "display-lg": ["Inter"],
                    "label-md": ["Inter"],
                    "body-md": ["Inter"],
                    "title-lg": ["Inter"]
            },
            "fontSize": {
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "title-md": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
                    "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "600"}]
            }
          },
        },
      }
    }catch(_e){}</script>
    <title>Elsewedy Development - Create Account</title>
</head>
<body class="min-h-screen flex items-center justify-center p-gutter bg-surface">
<!-- Main Container -->
<main class="w-full max-w-md">
<!-- Logo Section -->
<div class="flex flex-col items-center mb-lg">
<div class="mb-sm">
<img src="https://elsewedydevelopment.com/wp-content/uploads/2023/04/SD-web-Logo.png" alt="Elsewedy Development" class="h-12 object-contain">
</div>
<p class="font-body-md text-body-md text-secondary mt-2">Knowledge Management Portal</p>
</div>
<!-- Registration Card -->
<div class="login-card bg-surface-container-lowest border border-outline-variant rounded-2xl p-lg">
<h1 class="font-headline-md text-headline-md text-on-surface mb-xl text-center">Create Account</h1>

<% if (typeof error !== 'undefined' && error) { %>
<div class="mb-md p-sm rounded-lg bg-error-container text-on-error-container border border-error font-body-md text-body-md">
<%= error %>
</div>
<% } %>

<form class="space-y-md" id="registerForm" method="POST" action="/register">
            box-shadow: 0 0 0 3px rgba(167, 36, 41, 0.1);
        }
        .form-group button {
            width: 100%;
            padding: 12px;
            background-color: #a72429;
            color: white;
            border: none;
            border-radius: 6px;

<!-- Email Field -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-secondary uppercase tracking-wider block" for="email">Email Address</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-secondary">email</span>
<input 
class="w-full pl-xl pr-sm py-sm rounded-lg border border-outline-variant bg-surface-container focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md text-body-md" 
id="email" 
name="email" 
type="email"
placeholder="e.g. user@oracle.com" 
required="">
</div>
</div>
<!-- Password Field -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-secondary uppercase tracking-wider" for="password">Password</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-secondary">lock</span>
<input 
class="w-full pl-xl pr-sm py-sm rounded-lg border border-outline-variant bg-surface-container focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md text-body-md" 
id="password" 
name="password" 
type="password"
placeholder="••••••••" 
minlength="6"
required="">
<p class="font-label-md text-label-md text-secondary mt-xs">At least 6 characters</p>
</div>
</div>
<!-- Action Button -->
<div class="pt-sm">
<button class="btn-primary w-full py-sm rounded-lg text-white font-title-md text-title-md shadow-lg flex items-center justify-center gap-xs bg-primary hover:opacity-90 active:scale-95 transition-all" type="submit">
Create Account
<span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</button>
</div>
</form>
<div class="mt-xl pt-md border-t border-outline-variant text-center">
<p class="font-body-md text-body-md text-secondary">
Already have an account? 
<a class="text-primary font-semibold hover:underline" href="/login">Sign in here</a>
</p>
</div>
</div>
<!-- Footer Info -->
<footer class="mt-xl text-center space-y-xs opacity-60">
<p class="font-label-md text-label-md text-on-surface-variant">© <%= currentYear %> Oracle CRM Knowledge Base. Internal Use Only.</p>
<div class="flex justify-center gap-md">
<a class="font-label-md text-label-md text-secondary hover:text-primary underline" href="#">Privacy Policy</a>
<a class="font-label-md text-label-md text-secondary hover:text-primary underline" href="#">Security</a>
</div>
</footer>
</main>
<style>
.btn-primary {
background-color: #850515;
}
.btn-primary:hover {
opacity: 0.9;
}
</style>
</body>
</html>