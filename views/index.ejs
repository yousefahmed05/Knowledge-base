</footer>
<script>
const searchInput = document.getElementById('kb-search-input');
const resultsTitle = document.getElementById('results-count');
const newsScrollerSection = document.getElementById('news-scroller-section');
const defaultResultsTitle = `Top Recommendations (<%= destinations && destinations.length > 0 ? destinations.length : 0 %>)`;

function cardMatches(card, query) {
    if (!query) return true;
    const title = (card.getAttribute('data-title') || '').toLowerCase();
    const description = (card.getAttribute('data-description') || '').toLowerCase();
    const category = (card.getAttribute('data-category') || '').toLowerCase();
    const searchText = (card.getAttribute('data-search-text') || '').toLowerCase();
    return title.includes(query) || description.includes(query) || category.includes(query) || searchText.includes(query);
}

searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    let visibleCount = 0;
    let visibleNewsInScroller = 0;

    // Filter top recommendation articles
    document.querySelectorAll('[data-article-card]').forEach(card => {
        const matches = cardMatches(card, query);
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
    });

    // News result cards in the grid: only when searching
    document.querySelectorAll('[data-news-result-card]').forEach(card => {
        if (!query) {
            card.classList.add('hidden');
            card.style.display = 'none';
            return;
        }
        const matches = cardMatches(card, query);
        if (matches) {
            card.classList.remove('hidden');
            card.style.display = '';
            visibleCount++;
        } else {
            card.classList.add('hidden');
            card.style.display = 'none';
        }
    });

    // Filter news scroller
    document.querySelectorAll('[data-news-card]').forEach(card => {
        const matches = cardMatches(card, query);
        card.style.display = matches ? '' : 'none';
        if (matches) visibleNewsInScroller++;
    });

    if (newsScrollerSection) {
        newsScrollerSection.style.display = (!query || visibleNewsInScroller > 0) ? '' : 'none';
    }

    if (query.length > 0) {
        resultsTitle.innerText = `Results for "${query}" (${visibleCount})`;
    } else {
        resultsTitle.innerText = defaultResultsTitle;
        document.querySelectorAll('[data-article-card]').forEach(card => {
            card.style.display = '';
        });
    }

    const resultsGrid = document.getElementById('search-results-grid');
    if (visibleCount === 0 && query.length > 0) {
        let emptyState = document.getElementById('search-empty-state');
        if (!emptyState) {
            emptyState = document.createElement('div');
            emptyState.id = 'search-empty-state';
            emptyState.className = 'md:col-span-2 xl:col-span-3 text-center py-lg';
            emptyState.innerHTML = `
                <span class="material-symbols-outlined text-[48px] text-secondary mx-auto mb-md opacity-50">search</span>
                <h3 class="font-title-lg text-title-lg text-on-surface">No results found</h3>
                <p class="font-body-md text-body-md text-secondary">Try searching with different keywords.</p>
            `;
            resultsGrid.appendChild(emptyState);
        }
        emptyState.style.display = '';
    } else {
        const emptyState = document.getElementById('search-empty-state');
        if (emptyState) emptyState.style.display = 'none';
    }
});

document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
    }
});
</script>
</body>
</html>