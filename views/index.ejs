<div class="flex gap-md w-max" id="news-scroller-track">
<% newsItems.forEach(item => { %>
<a href="/news/<%= item._id %>" class="group relative block w-64 sm:w-72 shrink-0 rounded-xl overflow-hidden border border-outline-variant bg-surface shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all snap-start" data-news-card data-title="<%= item.title %>" data-search-text="<%= (item.title || '') + ' ' + (item.content || '') %>">
<img src="<%= item.imageUrl %>" alt="<%= (item.title || '').replace(/<[^>]*>/g, '') %>" class="w-full h-40 object-cover group-hover:scale-[1.02] transition-transform duration-300">
<div class="p-sm">
<p class="font-title-md text-title-md text-on-surface line-clamp-2 group-hover:text-primary transition-colors"><%= (item.title || '').replace(/<[^>]*>/g, '') %></p>
</div>
</a>
<% }); %>
</div>
