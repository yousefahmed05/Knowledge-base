    <title>Oracle CRM Knowledge Base | GlobalTours</title>
</head>
<body class="bg-surface font-body-lg text-on-surface custom-scrollbar">
<!-- TopNavBar -->
<header class="bg-surface dark:bg-surface-container border-b border-outline-variant dark:border-outline sticky top-0 z-50">
