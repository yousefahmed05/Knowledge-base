</div>
</section>
<% } %>
<!-- Results Section -->
<section class="px-gutter py-lg">
<div class="flex justify-between items-baseline mb-lg">
<h2 class="font-headline-md text-headline-md text-on-surface" id="results-count">Top Recommendations (<%= destinations && destinations.length > 0 ? destinations.length : 0 %>)</h2>
</div>
<!-- Results Grid (Bento Style) -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-md" id="search-results-grid">
<% if (destinations && destinations.length > 0) { %>
<% destinations.forEach((destination, index) => { %>
<%
const destinationContent = destination.content || destination.details || '';
const destinationBody = getArticleBody(destination);
const destinationSteps = destinationBody.steps;
const destinationDepartments = destinationSteps.map((step) => step.department).filter(Boolean);
const destinationPlainDescription = stripHtml(destination.description || destination.details || '');
const destinationSearchText = [
    destination.name || '',
    destinationPlainDescription,
    stripHtml(destinationBody.bulkContent || ''),
    ...destinationSteps.map((s) => [s.department, stripHtml(s.content)].join(' '))
].join(' ');
%>
<!-- Result Card -->
<article class="bg-surface border border-outline-variant rounded-xl p-md shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col group h-full min-w-0 overflow-hidden" data-article-card data-title="<%= destination.name %>" data-description="<%= destinationPlainDescription %>" data-category="<%= destination.category && destination.category.name ? destination.category.name : '' %>" data-search-text="<%= destinationSearchText %>">
<h3 class="font-title-lg text-title-lg text-on-surface mb-sm group-hover:text-primary transition-colors break-words" style="overflow-wrap: anywhere; word-break: break-word;"><%= destination.name %></h3>
<p class="font-body-md text-body-md text-secondary mb-lg flex-1 break-words" style="overflow-wrap: anywhere; word-break: break-word;"><%= destinationPlainDescription || 'No description provided yet.' %></p>
<div class="flex items-center justify-between pt-md border-t border-outline-variant">
<div class="flex items-center gap-xs text-secondary font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px]">update</span>
<% if (destination.updatedAt) { %>
<%= new Date(destination.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
<% } else { %>
Recently updated
<% } %>
</div>
<a href="/serviceReq/<%= destination.slug %>" class="px-md py-xs bg-primary-container text-on-tertiary rounded-lg font-title-md text-title-md hover:opacity-90 active:scale-95 transition-all">Open</a>
</div>
</article>
<% }); %>
<% } %>
<% if (typeof newsItems !== 'undefined' && newsItems && newsItems.length > 0) { %>
<% newsItems.forEach(item => { %>
<article class="bg-surface border border-outline-variant rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col group h-full hidden" data-news-result-card data-title="<%= item.title %>" data-search-text="<%= (item.title || '') + ' ' + (item.content || '') %>">
<img src="<%= item.imageUrl %>" alt="<%= (item.title || '').replace(/<[^>]*>/g, '') %>" class="w-full h-36 object-cover">
<div class="p-md flex flex-col flex-1">
<p class="font-label-md text-label-md text-primary mb-xs">News</p>
<h3 class="font-title-lg text-title-lg text-on-surface mb-sm group-hover:text-primary transition-colors"><%= (item.title || '').replace(/<[^>]*>/g, '') %></h3>
<p class="font-body-md text-body-md text-secondary mb-lg flex-1 line-clamp-3"><%= (item.content || '').replace(/<[^>]*>/g, '') %></p>
<div class="flex items-center justify-between pt-md border-t border-outline-variant">
<a href="/news/<%= item._id %>" class="px-md py-xs bg-primary-container text-on-tertiary rounded-lg font-title-md text-title-md hover:opacity-90 active:scale-95 transition-all">Open</a>
</div>
</div>
</article>
<% }); %>
<% } %>
<% if ((!destinations || destinations.length === 0) && (!newsItems || newsItems.length === 0)) { %>
<!-- Empty State -->
<div class="md:col-span-2 xl:col-span-3 text-center py-lg">
<span class="material-symbols-outlined text-[48px] text-secondary mx-auto mb-md opacity-50">description</span>
<h3 class="font-title-lg text-title-lg text-on-surface">No knowledge articles available yet</h3>
<p class="font-body-md text-body-md text-secondary">Add services in the admin panel and they will appear here.</p>
</div>
<% } %>
</div>
<!-- Load More / Pagination -->
<div class="mt-xl flex justify-center">
<a class="px-xl py-sm border-2 border-outline-variant rounded-lg font-title-md text-title-md text-secondary hover:bg-surface-variant hover:border-secondary transition-all" href="/serviceReq">
Load More Articles
</a>
</div>
</section>
</main>
</div>
<div id="article-modal" class="fixed inset-0 z-[100] hidden bg-black/50 p-4">
  <div class="mx-auto flex max-h-[85vh] w-full max-w-2xl flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex items-start justify-between border-b border-outline-variant px-lg py-md">
      <div>
        <p id="article-modal-category" class="font-label-md text-label-md text-primary mb-xs"></p>
        <h3 id="article-modal-title" class="font-headline-md text-headline-md text-on-surface"></h3>
      </div>
      <button id="article-modal-close" type="button" class="rounded-full p-2 text-secondary hover:bg-surface-variant">✕</button>
    </div>
    <div class="overflow-y-auto px-lg py-md">
      <div class="mb-md">
        <h4 class="font-title-md text-title-md text-on-surface mb-xs">Description</h4>
        <p id="article-modal-description" class="font-body-lg text-body-lg text-secondary break-words" style="overflow-wrap: anywhere; word-break: break-word; white-space: pre-wrap;"></p>
      </div>
      <div>
        <h4 class="font-title-md text-title-md text-on-surface mb-xs">Detailed Content</h4>
        <div id="article-modal-content" class="font-body-md text-body-md text-on-surface leading-7 break-words min-w-0" style="overflow-wrap: anywhere; word-break: break-word; white-space: pre-wrap;"></div>
      </div>
    </div>
  </div>
</div>
<script>
  const escapeHtml = (value) => String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  const modal = document.getElementById('article-modal');
  const modalTitle = document.getElementById('article-modal-title');
  const modalCategory = document.getElementById('article-modal-category');
  const modalDescription = document.getElementById('article-modal-description');
  const modalContent = document.getElementById('article-modal-content');
  const modalClose = document.getElementById('article-modal-close');

  document.querySelectorAll('[data-open-article]').forEach((button) => {
    button.addEventListener('click', () => {
      const article = JSON.parse(button.getAttribute('data-open-article'));
      modalTitle.textContent = article.name || 'Article';
      modalCategory.textContent = article.category || '';
      modalDescription.textContent = article.description || '';
      const detailContent = article.content || article.description || 'No content available yet.';
      const detailSections = detailContent.split(/\n\s*\n/).filter(Boolean);
      modalContent.innerHTML = detailSections.map((section, index) => {
        const lines = section.split(/\r?\n/);
        const firstLine = lines[0] || '';
        const numberedMatch = firstLine.match(/^(\d+)\.\s*(.*)$/);
        const numberText = numberedMatch ? `${numberedMatch[1]}.` : `${index + 1}.`;
        const contentText = numberedMatch ? lines.slice(1).join('\n').trim() : section.trim();
        return `<div class="flex gap-sm mb-sm min-w-0"><span class="font-semibold text-primary shrink-0">${numberText}</span><div class="flex-1 min-w-0 break-words" style="overflow-wrap: anywhere; word-break: break-word; white-space: pre-wrap;">${contentText.replace(/\n/g, '<br>')}</div></div>`;
      }).join('');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    });
  });

  const closeModal = () => {
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  };

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
</script>
<!-- Footer -->
<footer class="bg-surface dark:bg-surface-container border-t border-outline-variant dark:border-outline">
<div class="flex flex-col md:flex-row justify-between items-center py-lg px-gutter w-full max-w-max_width mx-auto gap-md">
